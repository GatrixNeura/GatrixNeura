---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { projects } from '../data/projects';
---

<BaseLayout>
  <Navbar />

  <!-- ══════════ HOME ══════════ -->
  <div class="page active" id="page-home">
    <section class="hero">
      <div class="corner-deco tl"></div>
      <div class="corner-deco br"></div>
      <h1 class="hero-title">
        <span>DYLAN</span>
        <span class="stroke glitch" data-text="FERNANDEZ">FERNANDEZ</span>
      </h1>
      <p class="hero-subtitle">GAME DEVELOPER<span class="cursor"></span></p>
      <p class="hero-desc">
        Diseño y desarrollo videojuegos desde cero, combinando mecánicas sólidas, arte procedural
        y narrativas inmersivas. Especializado en Unity y Unreal Engine, con foco en experiencias
        indie que desafían los géneros.
      </p>
      <div class="hero-stats">
        <div class="stat">
          <div class="stat-num">12+</div>
          <div class="stat-label">PROYECTOS</div>
        </div>
        <div class="stat">
          <div class="stat-num">5</div>
          <div class="stat-label">AÑOS EXP.</div>
        </div>
        <div class="stat">
          <div class="stat-num">3</div>
          <div class="stat-label">GAME JAMS</div>
        </div>
      </div>
      <button
        class="btn-primary"
        onclick="document.querySelector('.section-header').scrollIntoView({behavior:'smooth'})"
      >
        VER PROYECTOS
      </button>
      <svg class="hero-dots" viewBox="0 0 200 200" fill="none">
        <circle cx="100" cy="100" r="80" stroke="#00ffe0" stroke-width="1" stroke-dasharray="6 10" />
        <circle cx="100" cy="100" r="50" stroke="#ff3d6b" stroke-width="1" stroke-dasharray="4 14" />
        <circle cx="100" cy="100" r="20" stroke="#7b2fff" stroke-width="1" />
      </svg>
    </section>

    <SectionHeader label="PROYECTOS" />

    <div class="projects-grid">
      {projects.map((p, i) => (
        <ProjectCard
          index={i}
          tag={p.cardTag}
          title={p.title}
          desc={p.cardDesc}
          tech={p.tech.slice(0, 3)}
          emoji={p.cardEmoji}
          gradient={p.cardGradient}
        />
      ))}
    </div>

    <Footer />
  </div>

  <!-- ══════════ DETAIL ══════════ -->
  <div class="page" id="page-detail">
    <button class="detail-back" onclick="navigate('home')">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M19 12H5M12 5l-7 7 7 7" />
      </svg>
      VOLVER A PROYECTOS
    </button>
    <div class="detail-hero">
      <div class="detail-genre" id="d-genre"></div>
      <h1 class="detail-title" id="d-title"></h1>
    </div>
    <div class="detail-main">
      <div class="detail-media">
        <div class="detail-video-wrap">
          <div class="video-placeholder">
            <svg width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <polygon points="5 3 19 12 5 21 5 3" />
            </svg>
            <span>GAMEPLAY TRAILER</span>
          </div>
        </div>
        <div class="detail-screenshots" id="d-screenshots"></div>
      </div>
      <div class="detail-info">
        <div class="detail-desc-block"><h3>// DESCRIPCIÓN</h3><p id="d-desc"></p></div>
        <div class="detail-desc-block"><h3>// MECÁNICAS</h3><p id="d-mechanics"></p></div>
        <div>
          <div class="detail-desc-block" style="margin-bottom:14px"><h3>// TECNOLOGÍAS</h3></div>
          <div class="detail-tech-list" id="d-tech"></div>
        </div>
        <div class="detail-meta" id="d-meta"></div>
      </div>
    </div>
    <div class="files-section">
      <h3>// ARCHIVOS DEL PROYECTO</h3>
      <div class="repo-box">
        <div class="repo-header">
          <span id="repo-name">proyecto</span>
          <span id="repo-count">0 archivos</span>
        </div>
        <div id="d-files"></div>
      </div>
    </div>
    <Footer />
  </div>

  <!-- ══════════ ABOUT ══════════ -->
  <div class="page" id="page-about">
    <SectionHeader label="SOBRE MÍ" style="padding-top:120px" />
    <div class="about-wrap">
      <div class="about-photo-col">
        <div class="about-photo-frame">
          <!--
            Para agregar tu foto real, reemplazá el bloque de abajo por:
            <img src="/images/foto.jpg" alt="Dylan Fernandez">
          -->
          <div class="about-photo-placeholder">
            <svg width="64" height="64" fill="none" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
              <circle cx="12" cy="7" r="4" />
            </svg>
            <span>TU FOTO</span>
          </div>
        </div>
        <div class="about-name-tag">DYLAN FERNANDEZ</div>
        <div class="about-role-tag">// GAME DEVELOPER</div>
        <div class="about-skills">
          <span class="tech-badge">UNITY</span>
          <span class="tech-badge">UNREAL 5</span>
          <span class="tech-badge">C#</span>
          <span class="tech-badge">C++</span>
          <span class="tech-badge">GODOT 4</span>
          <span class="tech-badge">BLENDER</span>
          <span class="tech-badge">SHADER</span>
          <span class="tech-badge">GIT</span>
        </div>
      </div>
      <div class="about-bio">
        <div class="about-bio-section">
          <h3>// SOBRE MÍ</h3>
          <p>
            Soy Dylan Fernandez, desarrollador de videojuegos con más de 5 años de experiencia
            creando proyectos independientes que abarcan desde RPGs de mundo abierto hasta juegos
            de terror narrativo. Mi pasión por los videojuegos comenzó en la infancia y se convirtió
            en mi profesión cuando entendí que podía construir los mundos que siempre quise explorar.
          </p>
          <p style="margin-top:12px">
            Me especializo en la integración de sistemas complejos: IA de comportamiento, generación
            procedural y diseño de audio reactivo. Trabajo tanto como desarrollador principal como en
            roles de programador en equipos pequeños, y disfruto especialmente de las game jams como
            campo de entrenamiento creativo.
          </p>
        </div>
        <div class="about-bio-section">
          <h3>// EXPERIENCIA</h3>
          <div class="about-exp-item">
            <div class="about-exp-title">Lead Developer — Proyectos Indie</div>
            <div class="about-exp-place">Freelance · 2020 – Presente</div>
            <div class="about-exp-desc">
              Desarrollo completo de videojuegos: diseño, programación, audio y publicación.
              Proyectos en PC, Web y consolas.
            </div>
          </div>
          <div class="about-exp-item">
            <div class="about-exp-title">Programador Junior</div>
            <div class="about-exp-place">Estudio indie local · 2019 – 2020</div>
            <div class="about-exp-desc">
              Desarrollo de mecánicas y sistemas de juego en Unity. Colaboración con equipo de arte
              y diseño de niveles.
            </div>
          </div>
          <div class="about-exp-item">
            <div class="about-exp-title">Participante — Ludum Dare 54</div>
            <div class="about-exp-place">Game Jam Online · 2023</div>
            <div class="about-exp-desc">
              Desarrollo de Pulsar Drift en 72 horas. Ganador de categoría en mecánicas innovadoras.
            </div>
          </div>
        </div>
        <div class="about-bio-section">
          <h3>// EDUCACIÓN</h3>
          <div class="about-exp-item">
            <div class="about-exp-title">Tecnicatura en Desarrollo de Videojuegos</div>
            <div class="about-exp-place">Universidad · 2017 – 2020</div>
            <div class="about-exp-desc">
              Fundamentos de programación, diseño de juegos, gráficos 3D y producción de audio interactivo.
            </div>
          </div>
          <div class="about-exp-item">
            <div class="about-exp-title">Cursos Online — Unreal Engine 5 y Godot 4</div>
            <div class="about-exp-place">Udemy / YouTube · 2021 – 2023</div>
            <div class="about-exp-desc">
              Especialización autodidacta en motores adicionales, shaders y sistemas de IA avanzados.
            </div>
          </div>
        </div>
        <div class="about-bio-section">
          <h3>// CONTACTO RÁPIDO</h3>
          <p>
            ¿Tenés un proyecto en mente o querés colaborar? Escribime a{' '}
            <a href="mailto:Dylanfer.enterprise@gmail.com" style="color:var(--accent);text-decoration:none">
              Dylanfer.enterprise@gmail.com
            </a>{' '}
            o usá el{' '}
            <a href="#" onclick="navigate('contact')" style="color:var(--accent2);text-decoration:none">
              formulario de contacto
            </a>.
          </p>
        </div>
      </div>
    </div>
    <Footer />
  </div>

  <!-- ══════════ CONTACT ══════════ -->
  <div class="page" id="page-contact">
    <SectionHeader label="CONTACTO" style="padding-top:120px" />
    <div class="contact-wrap">
      <div class="contact-intro">
        <p>
          ¿Tenés un proyecto, propuesta o simplemente querés charlar sobre videojuegos?
          Mandame un mensaje y te respondo lo antes posible.
        </p>
      </div>
      <a class="contact-email-link" href="mailto:Dylanfer.enterprise@gmail.com">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
          <polyline points="22,6 12,13 2,6" />
        </svg>
        Dylanfer.enterprise@gmail.com
      </a>
      <div class="contact-card">
        <div class="contact-field">
          <label class="contact-label">// TU NOMBRE</label>
          <input class="contact-input" id="c-name" type="text" placeholder="Tu nombre completo" />
        </div>
        <div class="contact-field">
          <label class="contact-label">// TU EMAIL</label>
          <input class="contact-input" id="c-email" type="email" placeholder="tu@email.com" />
        </div>
        <div class="contact-field">
          <label class="contact-label">// ASUNTO</label>
          <input class="contact-input" id="c-subject" type="text" placeholder="¿De qué se trata?" />
        </div>
        <div class="contact-field">
          <label class="contact-label">// MENSAJE</label>
          <textarea class="contact-textarea" id="c-message" placeholder="Contame sobre tu proyecto o consulta..."></textarea>
        </div>
        <button class="contact-send-btn" onclick="sendContact()">ENVIAR MENSAJE →</button>
        <div class="contact-success" id="c-success">✓ MENSAJE ENVIADO — Te respondo a la brevedad.</div>
      </div>
    </div>
    <Footer />
  </div>
</BaseLayout>

<script>
  import { projects } from '../data/projects';

  // ── STATE ──
  let currentDetailProject: any = null;

  // ── NAVIGATION ──
  function navigate(page: string, opts: any = {}) {
    const tr = document.getElementById('transition') as HTMLElement;
    const colors: Record<string, string> = {
      home: 'var(--accent)', about: 'var(--accent3)',
      contact: 'var(--accent2)', detail: 'var(--accent)'
    };
    tr.style.background = colors[page] || 'var(--accent)';
    tr.className = 'page-transition in';

    setTimeout(() => {
      document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
      const target = document.getElementById('page-' + page);
      if (target) target.classList.add('active');

      document.querySelectorAll('.nav-links a').forEach(a => a.classList.remove('active'));
      const navMap: Record<string, string> = { home: 'nav-inicio', about: 'nav-about', contact: 'nav-contact' };
      if (navMap[page]) document.getElementById(navMap[page])?.classList.add('active');

      if (page === 'detail' && opts.idx !== undefined) populateDetail(projects[opts.idx]);

      window.scrollTo({ top: 0, behavior: 'instant' });
      history.pushState({ page, idx: opts.idx }, '', '#' + page + (opts.idx !== undefined ? '-' + opts.idx : ''));

      tr.className = 'page-transition out';
      tr.addEventListener('animationend', () => { tr.className = 'page-transition'; }, { once: true });
    }, 350);
  }

  window.addEventListener('popstate', (e: PopStateEvent) => {
    if (e.state && e.state.page) {
      const { page, idx } = e.state;
      document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
      document.getElementById('page-' + page)?.classList.add('active');
      if (page === 'detail' && idx !== undefined) populateDetail(projects[idx]);
      document.querySelectorAll('.nav-links a').forEach(a => a.classList.remove('active'));
      const navMap: Record<string, string> = { home: 'nav-inicio', about: 'nav-about', contact: 'nav-contact' };
      if (navMap[page]) document.getElementById(navMap[page])?.classList.add('active');
      window.scrollTo({ top: 0, behavior: 'instant' });
    }
  });

  // ── SHOCKWAVE ──
  function spawnShockwave(x: number, y: number) {
    const el = document.createElement('div');
    el.className = 'shockwave';
    el.style.left = x + 'px';
    el.style.top = y + 'px';
    el.style.width = el.style.height = '60px';
    document.body.appendChild(el);
    el.addEventListener('animationend', () => el.remove());
  }

  function openProject(e: MouseEvent, idx: number) {
    const rect = (e.currentTarget as HTMLElement).getBoundingClientRect();
    spawnShockwave(rect.left + rect.width / 2, rect.top + rect.height / 2);
    navigate('detail', { idx });
  }

  // ── POPULATE DETAIL ──
  function populateDetail(p: any) {
    currentDetailProject = p;
    (document.getElementById('d-genre') as HTMLElement).textContent = p.genre;
    (document.getElementById('d-title') as HTMLElement).textContent = p.title;
    (document.getElementById('d-desc') as HTMLElement).textContent  = p.desc;
    (document.getElementById('d-mechanics') as HTMLElement).textContent = p.mechanics;
    (document.getElementById('repo-name') as HTMLElement).textContent   = p.title;
    (document.getElementById('repo-count') as HTMLElement).textContent  = p.files.length + ' archivos';

    (document.getElementById('d-tech') as HTMLElement).innerHTML =
      p.tech.map((t: string) => `<span class="tech-badge">${t}</span>`).join('');

    (document.getElementById('d-meta') as HTMLElement).innerHTML =
      p.meta.map((m: any) => `<div class="meta-item"><div class="meta-label">${m.l}</div><div class="meta-val">${m.v}</div></div>`).join('');

    (document.getElementById('d-screenshots') as HTMLElement).innerHTML =
      p.screenshots.map((s: string) => `<div class="ss-placeholder">${s}</div>`).join('');

    (document.getElementById('d-files') as HTMLElement).innerHTML = p.files.map((f: any, i: number) => `
      <div class="repo-file-row">
        <div class="repo-file-icon">${f.ext}</div>
        <div class="repo-file-name">${f.name}</div>
        <div class="repo-file-size">${f.size}</div>
        <div class="repo-file-actions">
          <button class="repo-btn view" onclick="viewFile(${i})">👁 VER</button>
          <button class="repo-btn dl"   onclick="downloadFile(${i})">⬇ DL</button>
        </div>
      </div>`).join('');
  }

  // ── SYNTAX HIGHLIGHT ──
  function syntaxHighlight(code: string, ext: string) {
    let h = code.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    h = h.replace(/(\/\/[^\n]*)/g, '<span class="cmt">$1</span>');
    h = h.replace(/(#(?!pragma)[^\n]*)/g, '<span class="cmt">$1</span>');
    h = h.replace(/("(?:[^"\\]|\\.)*"|'(?:[^'\\]|\\.)*')/g, '<span class="str">$1</span>');
    const kwCS  = /\b(public|private|protected|static|void|class|new|return|if|else|for|foreach|while|var|using|namespace|this|bool|int|float|string|null|true|false|override|virtual|const|get|set|abstract)\b/g;
    const kwGD  = /\b(func|var|const|if|else|elif|for|while|return|extends|class|self|null|true|false|and|or|not|pass|in|is|match|signal|onready|static|await)\b/g;
    const kwCPP = /\b(void|int|float|bool|class|public|private|protected|return|if|else|for|while|new|delete|nullptr|true|false|const|static|virtual|override|auto|struct|include|using|namespace)\b/g;
    const kwMap: Record<string, RegExp> = { CS: kwCS, GD: kwGD, CPP: kwCPP, H: kwCPP, INK: kwGD, SHADER: kwCS, GLSL: kwCS };
    h = h.replace(kwMap[ext] || kwCS, '<span class="kw">$1</span>');
    h = h.replace(/\b(\d+\.?\d*f?)\b/g, '<span class="num">$1</span>');
    h = h.replace(/\b([A-Z][A-Za-z0-9]{2,})\b/g, '<span class="cls">$1</span>');
    return h;
  }

  function viewFile(idx: number) {
    if (!currentDetailProject) return;
    const f = currentDetailProject.files[idx];
    (document.getElementById('modal-filename') as HTMLElement).textContent = f.name;
    (document.getElementById('modal-dl-btn') as HTMLElement).onclick = () => downloadFile(idx);
    const lines = (f.code || '').split('\n');
    (document.getElementById('modal-lines') as HTMLElement).innerHTML = lines.map((_: any, i: number) => i + 1).join('<br>');
    (document.getElementById('modal-code') as HTMLElement).innerHTML  = syntaxHighlight(f.code || '', f.ext);
    document.getElementById('codeModal')?.classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    document.getElementById('codeModal')?.classList.remove('open');
    document.body.style.overflow = '';
  }

  document.getElementById('codeModal')?.addEventListener('click', function (e) {
    if (e.target === this) closeModal();
  });

  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });

  function downloadFile(idx: number) {
    if (!currentDetailProject) return;
    const f = currentDetailProject.files[idx];
    const blob = new Blob([f.code || `// ${f.name}`], { type: 'text/plain' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = f.name;
    a.click();
    URL.revokeObjectURL(a.href);
  }

  function sendContact() {
    const name    = (document.getElementById('c-name') as HTMLInputElement).value.trim();
    const email   = (document.getElementById('c-email') as HTMLInputElement).value.trim();
    const subject = (document.getElementById('c-subject') as HTMLInputElement).value.trim();
    const message = (document.getElementById('c-message') as HTMLTextAreaElement).value.trim();
    if (!name || !email || !message) { alert('Por favor completá nombre, email y mensaje.'); return; }
    const mailto = `mailto:Dylanfer.enterprise@gmail.com?subject=${encodeURIComponent(subject || 'Contacto desde Portfolio')}&body=${encodeURIComponent('Nombre: ' + name + '\nEmail: ' + email + '\n\n' + message)}`;
    window.location.href = mailto;
    document.getElementById('c-success')?.classList.add('show');
    ['c-name', 'c-email', 'c-subject', 'c-message'].forEach(id => {
      const el = document.getElementById(id) as HTMLInputElement;
      if (el) el.value = '';
    });
  }

  // Expose to HTML onclick handlers
  (window as any).navigate     = navigate;
  (window as any).openProject  = openProject;
  (window as any).viewFile     = viewFile;
  (window as any).closeModal   = closeModal;
  (window as any).downloadFile = downloadFile;
  (window as any).sendContact  = sendContact;

  // ── INIT ──
  document.getElementById('nav-inicio')?.classList.add('active');
  history.replaceState({ page: 'home' }, '', '#home');
</script>
